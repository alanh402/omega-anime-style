# Copie para .env.local e preencha. Nunca coloque chaves secretas (service_role) aqui.

# URL pública do site (usada nos links compartilhados e nas prévias do WhatsApp)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# WhatsApp da loja: DDI + DDD + número, só dígitos.
# Com Supabase conectado, o número salvo em /admin/configuracoes tem prioridade.
NEXT_PUBLIC_WHATSAPP_NUMBER=5599985531987

# Supabase (Project Settings → API). Sem estas duas, o site roda com os dados de demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
